# Env vars for `docker compose up` (project root only -- NOT the same file
# as server/.env.example, though the values overlap). `docker compose`
# automatically reads a `.env` file next to docker-compose.yml and
# substitutes ${VAR} placeholders in it with these values.
#
# Copy this to `.env` (project root) before running `docker compose up`.

AWS_REGION=us-east-1
S3_BUCKET_NAME=your-resume-bucket-name
SES_SENDER_EMAIL=you@example.com
JWT_SECRET=change-me-to-a-long-random-string

# Creates (and re-seeds on every container restart) the single built-in
# admin account -- see server/scripts/seedAdmin.js. This is a login
# identity, not the same thing as SES_SENDER_EMAIL, though it's common to
# set them to the same verified address for local testing (see the SES
# sandbox notes in README.md).
ADMIN_EMAIL=admin@email.com
ADMIN_PASSWORD=password123
