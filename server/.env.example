# Copy this file to .env and fill in real values for local development.
# In AWS, these same variables are injected as environment variables /
# Secrets Manager secrets on the ECS task -- nothing here is hardcoded
# into the app.

# PostgreSQL connection string, e.g.:
# postgres://postgres:postgres@localhost:5432/job_portal
DATABASE_URL=postgres://postgres:postgres@localhost:5432/job_portal

# AWS region your S3 bucket / SES identity live in.
AWS_REGION=us-east-1

# S3 bucket used to store uploaded resumes.
S3_BUCKET_NAME=your-resume-bucket-name

# The SES identity (email address) verified to send "from". In SES sandbox
# mode this must be a verified identity -- see README for details.
SES_SENDER_EMAIL=you@example.com

# Secret used to sign JWTs. Use a long random string in real deployments.
JWT_SECRET=change-me-to-a-long-random-string

# Used only by `npm run seed:admin` to create the single built-in admin
# account. Not read anywhere else in the app.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me

PORT=3000
