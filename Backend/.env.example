# Copy this file to .env and fill in real values for local development.
# In AWS, these same variables are injected as environment variables /
# Secrets Manager secrets on the ECS task -- nothing here is hardcoded
# into the app.

# Discrete PostgreSQL connection params (matches the local `docker compose
# up db` container by default). Used instead of a single DATABASE_URL
# because the RDS-managed Secrets Manager secret exposes these as separate
# fields, not a pre-built URL -- see server/src/db.js.
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=job_portal

# Set to "true" to enable TLS for the database connection (needed for RDS
# in production). Leave unset/false for local Postgres, which doesn't
# speak TLS.
DB_SSL=false

# AWS region your S3 bucket / SES identity live in.
AWS_REGION=us-east-1

# S3 bucket used to store uploaded resumes.
S3_BUCKET_NAME=your-resume-bucket-name

# The SES identity (email address) verified to send "from". In SES sandbox
# mode this must be a verified identity -- see README for details.
SES_SENDER_EMAIL=you@example.com

# Secret used to sign JWTs. Use a long random string in real deployments.
JWT_SECRET=change-me-to-a-long-random-string

# Used by the app on every startup to create/update the single built-in
# admin account (see server/src/seedAdmin.js).
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me

PORT=3000
